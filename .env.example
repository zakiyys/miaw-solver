# Miaw Solver — contoh konfigurasi. Salin jadi .env lalu sesuaikan.
#   cp .env.example .env
# Semua variabel OPSIONAL — tanpa .env, solver tetap jalan (lokal, gratis).

# ---- Port host untuk API (dalam container tetap 8100) ----
MIAW_PORT=8100

# ---- Jaring pengaman 2captcha ----
# 0 = murni lokal (default). 1 = kalau solver lokal gagal, kirim ke 2captcha
# (BERBAYAR — pastikan kamu memang mau ini).
MIAW_FALLBACK=0
TWOCAPTCHA_API_KEY=

# ---- Keamanan API ----
# Kalau diisi, semua endpoint kecuali /health butuh header X-API-Key (atau ?key=).
# WAJIB diisi kalau server ini bisa diakses dari internet.
MIAW_API_KEY=
# Batas request per menit per IP. 0 = tanpa batas.
MIAW_RATE_LIMIT=0

# ---- Model audio (faster-whisper) ----
# tiny (cepat, kurang akurat) | base (default) | small (lebih akurat, lambat)
MIAW_WHISPER_MODEL=base

# Device: cpu (default) | cuda
# PENTING: TIDAK ADA auto-detect. Punya GPU pun, default tetap cpu sampai kamu
# set ini ke cuda. Hanya mesin audio yang memakai GPU; engine lain tidak.
MIAW_WHISPER_DEVICE=cpu

# Compute type. Kalau device=cuda, default otomatis jadi float16.
#   int8          — CPU (default)
#   float16       — GPU, paling cepat (butuh lib CUDA yang cocok)
#   int8_float16  — GPU, VRAM paling hemat
#   float32       — paling akurat, paling lambat
# Kalau CUDA salah setel, error muncul saat solve audio PERTAMA (model dimuat
# malas), bukan saat start. Cek dukungan runtime:
#   python -c "import ctranslate2; print(ctranslate2.get_supported_compute_types('cuda'))"
# MIAW_WHISPER_COMPUTE=int8
